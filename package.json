{
    "name": "lowcss",
    "version": "0.36.0",
    "description": "A low-level functional CSS toolkit",
    "author": {
        "name": "Josemi Juanes",
        "email": "hello@josemi.xyz"
    },
    "license": "MIT",
    "homepage": "https://josemi.xyz/lowcss",
    "repository": "https://github.com/jmjuanes/lowcss",
    "bugs": "https://github.com/jmjuanes/lowcss/issues",
    "type": "module",
    "style": "low.css",
    "exports": {
        ".": "./low.css",
        "./low.css": "./low.css",
        "./reset.css": "./reset.css",
        "./theme.css": "./theme.css",
        "./utilities.css": "./utilities.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "yarn run build:css && yarn run build:min && yarn run build:docs",
        "build:css": "node ./scripts/build.js",
        "build:min": "node ./scripts/concat.js",
        "build:docs": "node ./scripts/docs.js"
    },
    "keywords": [
        "css",
        "css-toolkit",
        "low-css",
        "functional-css",
        "css-utilities",
        "utilities",
        "css-classes"
    ],
    "files": [
        "README.md",
        "LICENSE",
        "low.css",
        "index.css",
        "theme.css",
        "reset.css",
        "utilities.css",
        "docs",
        "addons",
        "package.json"
    ],
    "devDependencies": {
        "csso": "^5.0.5"
    },
    "browserslist": [
        "last 10 Chrome versions",
        "last 4 Firefox versions",
        "last 3 Safari versions",
        "not Safari 12",
        "last 4 Edge versions",
        "not Edge <= 18",
        "Firefox ESR"
    ]
}